{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lof Audio",
  "version": "0.1.0-alpha.1",
  "identifier": "com.lof.audio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lof Audio",
        "width": 1360,
        "height": 840,
        "minWidth": 360,
        "minHeight": 620,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
